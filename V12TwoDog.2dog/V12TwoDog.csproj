<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
		<TwoDogVariant>editor</TwoDogVariant>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="2dog" Version="4.7.0.*" />
    </ItemGroup>

    <ItemGroup>
        <!-- Must be the SAME project path V12.Basic references internally
           (its nested libs/V12 submodule). Referencing ../libs/V12 as well
           creates two projects with the identity V12/1.0.0, which makes the
           SDK drop V12 from the generated deps.json entirely — and Godot's
           PluginLoadContext then cannot resolve V12.dll at runtime. -->
      <ProjectReference Include="../libs/V12.Basic/libs/V12/V12.csproj" />
      <ProjectReference Include="..\libs\V12.Basic\V12.Basic.csproj" />
      <ProjectReference Include="..\Nova.SDK\Nova.SDK.csproj" />
      <ProjectReference Include="..\Nova.Shared\Nova.Shared.csproj" />
      <ProjectReference Include="..\V12TwoDog.Godot\V12TwoDog.Godot.csproj" />
    </ItemGroup>
	<!-- Remove duplicate Godot.SourceGenerators that come from the Godot project
         (2dog package already embeds them) -->

    <!-- Godot project location -->
    <PropertyGroup>
        <GodotProjectDir>../V12TwoDog.Godot</GodotProjectDir>
        <UserSecretsId>db5adb7b-d95b-491a-8296-f6a6930914a7</UserSecretsId>
    </PropertyGroup>
</Project>
