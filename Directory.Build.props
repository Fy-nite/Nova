<Project>

  <!--
    Standalone defaults. Only used when this checkout is NOT nested inside
    V12-Monorepo; the import at the bottom overrides them with the monorepo
    sibling paths.

    Keep every reference to a given library pointing at ONE path. The same
    project reached under two different paths gets two identities (e.g.
    V12/1.0.0), which makes the SDK drop it from deps.json and Godot's
    PluginLoadContext then cannot resolve the DLL at runtime.
  -->
  <PropertyGroup>
    <V12BasicProject Condition="'$(V12BasicProject)' == ''">$(MSBuildThisFileDirectory)libs/V12.Basic/V12.Basic.csproj</V12BasicProject>
    <V12EngineProject Condition="'$(V12EngineProject)' == ''">$(MSBuildThisFileDirectory)libs/V12.Basic/libs/V12/V12.csproj</V12EngineProject>
    <V12BindingsProject Condition="'$(V12BindingsProject)' == ''">$(MSBuildThisFileDirectory)libs/V12.Basic/libs/V12.Bindings/V12.Bindings.csproj</V12BindingsProject>
  </PropertyGroup>

  <!--
    MSBuild imports only the nearest Directory.Build.props. Pull in the
    monorepo root props explicitly when the V12 sibling checkouts are present,
    so its path redirects win over the libs/ defaults above.
  -->
  <PropertyGroup>
    <_V12SiblingRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_V12SiblingRoot>
    <_V12MonorepoRoot Condition="Exists('$(_V12SiblingRoot)/V12-Engine/V12.csproj') and Exists('$(_V12SiblingRoot)/V12.Basic/V12.Basic.csproj')">$(_V12SiblingRoot)</_V12MonorepoRoot>
    <_V12MonorepoProps Condition="'$(_V12MonorepoRoot)' != ''">$([System.IO.Path]::Combine('$(_V12MonorepoRoot)', 'Directory.Build.props'))</_V12MonorepoProps>
  </PropertyGroup>
  <Import Project="$(_V12MonorepoProps)" Condition="'$(_V12MonorepoProps)' != '' and Exists('$(_V12MonorepoProps)')" />

</Project>
