# .NET build outputs
bin/
obj/
*.pdb

# Ignore everything else (NuGet cache, build output, etc.)
*.dll
*.exe

# Keep Godot addon native plugin binaries (must come after blanket *.dll)
!V12TwoDog.Godot/addons/**/*.dll
!V12TwoDog.Godot/addons/**/*.so
!V12TwoDog.Godot/addons/**/*.dylib
!V12TwoDog.Godot/addons/**/*.a

# User-specific files
*.user
*.suo
*.userprefs
.vs/
.vscode/
.idea/
build/
# Godot-specific ignores
.godot/
.import/
# export_presets.cfg

#files with tilde
~


# OS-specific
.DS_Store
Thumbs.db

# NuGet packages
*.nupkg
packages/
